# coffee — LOCAL development env. Copy to .env.local and fill the placeholders.
# Server deployments use .env.dev.example / .env.prod.example instead.
# Every variable the app reads is documented in docs/ENVIRONMENTS.md and listed
# in scripts/lib/env-manifest.mjs (CI fails if one is missing here).
# NEVER put real secrets or key material in this file — placeholders only.

# --- Runtime ---
PORT=3000
NODE_ENV=development
# Public ORIGIN of this app (no base path) — its host is the `aud` for scoped app tokens.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Mount path behind the reverse proxy: `/coffee` on dev/prod servers, empty locally.
# Baked at build time (next.config.js) and read by src/lib/base-path.ts.
NEXT_PUBLIC_BASE_PATH=
# Dev instance only: selects the imajin_session_dev cookie (`dev`). Unset on prod.
IMAJIN_ENV=dev

# --- This app's own database ---
# drizzle-orm + postgres (postgres.js), this app's own Postgres schema only.
# Never a kernel database or another app's schema — see docs/MIGRATIONS.md.
DATABASE_URL=postgres://coffee:CHANGE_ME@localhost:5432/imajin_dev
# The one Postgres schema this app owns. Must be `coffee`; never change it.
APP_DB_SCHEMA=coffee
# Tests only: a Postgres URL the integration/baseline tests may create throwaway databases on.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/coffee_ci

# --- Imajin kernel (the public app surface this app composes; see AGENTS.md §2) ---
# prod: https://jin.imajin.ai   dev: https://dev-jin.imajin.ai
IMAJIN_AUTH_URL=https://dev-jin.imajin.ai
# Same value, exposed to the browser (build time) — "Sign in with Imajin" redirect.
NEXT_PUBLIC_IMAJIN_AUTH_URL=https://dev-jin.imajin.ai
# Kernel auth service (with /auth prefix) — @ima-jin/auth verifies scoped app tokens/sessions here.
AUTH_SERVICE_URL=https://dev-jin.imajin.ai/auth
# Kernel registry service (with /registry prefix) — public node config for .fair manifests.
REGISTRY_SERVICE_URL=https://dev-jin.imajin.ai/registry
# Kernel base URL (no path) — used to fetch this app's signing key at boot.
IMAJIN_KERNEL_URL=https://dev-jin.imajin.ai
# Kernel origin the /dashboard -> hub redirect middleware targets (set before build AND start).
NEXT_PUBLIC_KERNEL_URL=https://dev-jin.imajin.ai

# --- Kernel pay service (Stripe Checkout + .fair settlement) ---
# Includes the /pay path prefix.
PAY_SERVICE_URL=https://dev-jin.imajin.ai/pay
# Browser-visible base URL of the same pay service (Stripe Connect payout banner; build time).
NEXT_PUBLIC_PAY_URL=https://dev-jin.imajin.ai/pay
# Shared secret the pay service presents on POST /api/webhook/payment. Unset -> webhook answers 500.
WEBHOOK_SECRET=REPLACE_ME
# Service key for POST {pay}/api/settle. Unset -> tip settlement is skipped (logged, non-fatal).
PAY_SERVICE_API_KEY=
# Optional settlement tuning.
PLATFORM_DID=did:imajin:platform
PLATFORM_FEE_PERCENT=1.5

# --- App identity (operator step — see README "Identity" and docs/REGISTRATION.md) ---
# This app refuses to start without IMAJIN_APP_DID (instrumentation.ts).
IMAJIN_APP_DID=did:imajin:REPLACE_ME
# Public registry id (`app_...`) returned by registration; used to build the sign-in redirect (build time).
NEXT_PUBLIC_IMAJIN_APP_ID=app_REPLACE_ME
# One-time claim code from the kernel operator's /jin approval card. FIRST BOOT ONLY (no keystore yet);
# delete it once the app has booted successfully. A lost keystore needs a fresh code (reissueClaim).
# IMAJIN_APP_CLAIM_CODE=
# Where the local bootstrap keypair is persisted (mode 0600). Default ./.imajin/keystore.json.
# Never the signing key itself; must persist across deploys and be separate for dev and prod.
# IMAJIN_APP_KEYSTORE=
# FORBIDDEN — never set this: the app refuses to boot if it is (the signing key is fetched at boot,
# never read from env).
# IMAJIN_APP_PRIVATE_KEY=

# --- Session (signed by @ima-jin/auth-client, HS256) ---
# 32+ random bytes, e.g.: openssl rand -hex 32
SESSION_SECRET=REPLACE_ME

# --- Set by the platform (never set by hand) ---
# NEXT_RUNTIME is injected by Next.js; PORT and NODE_ENV (above) are set by the pm2 entry on servers.
# NEXT_RUNTIME=

# --- Optional / dependency knobs (leave unset unless you know you need them) ---
# LOG_LEVEL=info
# NEXT_PUBLIC_VERSION=
# NEXT_PUBLIC_BUILD_HASH=
# NEXT_PUBLIC_SERVICE_PREFIX=
# NEXT_PUBLIC_DOMAIN=
# SESSION_COOKIE_SCOPE=
# REGISTRY_URL=
# NEXT_PUBLIC_COMMIT_COUNT=
# NEXT_PUBLIC_NOTIFY_URL=
# ENABLE_REQUEST_LOG=
# ENABLE_APP_LOG=
# LOG_DB_TRANSPORT=
# APP_LOG_LEVEL=
# ATTESTATION_INTERNAL_API_KEY=
# AUTH_INTERNAL_API_KEY=
# PROFILE_SERVICE_URL=
# PROFILE_INTERNAL_API_KEY=
# NODE_DID=
# APP_URL=
# NEXT_PUBLIC_BASE_URL=
# IMAJIN_APP_ATTESTATION_ID=
